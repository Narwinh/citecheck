# Copy to .env (gitignored) and fill in. Never commit real keys.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://app.tavily.com (free tier: 1,000 credits/month)
TAVILY_API_KEY=

# Optional overrides. Check https://ai.google.dev/gemini-api/docs/models for current names.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# API server (see backend/app/config.py)
# CORS_ORIGINS=http://localhost:3000
# RATE_LIMIT_PER_HOUR=5
# TRUSTED_PROXIES=0
